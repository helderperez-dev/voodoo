# Voodoo Framework — Environment Variables
#
# All variables are optional for local development. A fresh application uses
# Voodoo Store at .voodoo/application.vstore and requires no external database,
# queue, event server or object server.
#
# Precedence: project config > VOODOO_* environment variables > Runtime defaults

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# VOODOO_ENV=production
# VOODOO_DEBUG=false
# VOODOO_HOST=0.0.0.0
# VOODOO_PORT=8000

# ---------------------------------------------------------------------------
# Voodoo Store — default durable application infrastructure
# ---------------------------------------------------------------------------

# Default provider is "voodoo".
# VOODOO_STORE_PROVIDER=voodoo

# Default path:
# VOODOO_STORE_PATH=.voodoo/application.vstore

# Keep Store enabled for the Store-first default Runtime. Disabling it while
# default Store-backed domains are selected fails explicitly; it does not fall
# back to SQLite.
# VOODOO_STORE_ENABLED=true

# Durability mode supported by the Store binding/configuration.
# VOODOO_STORE_DURABILITY=data
# VOODOO_STORE_REPAIR_TORN_TAIL=true

# IMPORTANT: one Runtime process owns one live local Store writer. Do not point
# multiple uvicorn/gunicorn workers or Voodoo Nodes at the same .vstore file.

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------

# MUST be replaced in production.
# VOODOO_SECRET_KEY=change-me-in-production
# VOODOO_TOKEN_EXPIRY=604800

# ---------------------------------------------------------------------------
# Database domain
# ---------------------------------------------------------------------------

# Fresh-app default:
# VOODOO_DATABASE_PROVIDER=voodoo

# Explicit PostgreSQL override:
# VOODOO_DATABASE_PROVIDER=postgres
# VOODOO_DATABASE_URL=postgresql://user:pass@localhost:5432/voodoo

# Explicit SQLite compatibility override:
# VOODOO_DATABASE_PROVIDER=sqlite
# VOODOO_DB_PATH=.voodoo/state/data.db

# DATABASE_URL is also recognized for explicit supported SQL URLs.
# DATABASE_URL=postgresql://user:pass@localhost:5432/voodoo

# ---------------------------------------------------------------------------
# Durable Queue / Jobs
# ---------------------------------------------------------------------------

# Fresh-app default:
# VOODOO_QUEUE_PROVIDER=voodoo

# Explicit Redis override:
# VOODOO_QUEUE_PROVIDER=redis
# VOODOO_QUEUE_URL=redis://localhost:6379/0

# Other registered explicit queue adapters may have their own requirements.
# VOODOO_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------

# Fresh-app default:
# VOODOO_EVENTS_PROVIDER=voodoo

# Explicit provider examples:
# VOODOO_EVENTS_PROVIDER=postgres
# VOODOO_EVENTS_URL=postgresql://user:pass@localhost:5432/voodoo

# Legacy/provider-specific file paths apply only when that provider is selected.
# VOODOO_EVENTS_PATH=.voodoo/state/events.db

# ---------------------------------------------------------------------------
# Objects
# ---------------------------------------------------------------------------

# Fresh-app default:
# VOODOO_OBJECTS_PROVIDER=voodoo

# Explicit S3-compatible override:
# VOODOO_OBJECTS_PROVIDER=s3
# VOODOO_BUCKET=my-bucket
# VOODOO_OBJECTS_ENDPOINT=https://object.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Explicit local/filesystem adapter settings apply only when selected.
# VOODOO_OBJECTS_DIR=.voodoo/objects

# ---------------------------------------------------------------------------
# Cache — transient by default
# ---------------------------------------------------------------------------

# Cache is intentionally memory-backed unless explicitly overridden.
# VOODOO_CACHE_PROVIDER=memory
# VOODOO_CACHE_PROVIDER=redis
# VOODOO_CACHE_URL=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Edge
# ---------------------------------------------------------------------------

# Edge durable device/session/effect/replay state uses the same Runtime Store by
# default when Edge is enabled.
# VOODOO_EDGE_ENABLED=true
# VOODOO_EDGE_MQTT_ENABLED=false

# ---------------------------------------------------------------------------
# AI models — optional
# ---------------------------------------------------------------------------

# VOODOO_MODELS_DEFAULT=mock:default
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# User uploads/static files
# ---------------------------------------------------------------------------

# This is application file content, separate from Runtime durable infrastructure.
# VOODOO_STORAGE_DIR=storage

# ---------------------------------------------------------------------------
# TEST INFRASTRUCTURE — optional contract-test services
# ---------------------------------------------------------------------------

# PostgreSQL contracts
# VOODOO_TEST_DATABASE_URL=postgresql://voodoo:voodoo@localhost:5432/voodoo_test

# S3-compatible contracts
# VOODOO_TEST_S3_ENDPOINT=http://localhost:9000
# VOODOO_TEST_S3_BUCKET=voodoo-test
# VOODOO_TEST_S3_KEY=minioadmin
# VOODOO_TEST_S3_SECRET=minioadmin

# Redis contracts
# VOODOO_TEST_REDIS_URL=redis://localhost:6379/0
