# Voodoo Framework Environment Variables

# Database
# In development, leave commented to use `.data/voodoo.db`
# In production, set the absolute path where the persistent volume is mounted.
# VOODOO_DB_PATH=/var/lib/data/voodoo.db

# PostgreSQL contract tests (tests/contracts/test_database_postgres.py)
# Set this to a PostgreSQL connection URL to run the PG adapter contract
# suite; leave commented to skip it (default local runs stay zero-infra).
# Enable:  VOODOO_TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/db
# Disable: comment the line out — tests skip with a clear reason.
# Example local container:
#   docker run --name voodoo-pg -e POSTGRES_DB=voodoo_test \
#     -e POSTGRES_USER=voodoo -e POSTGRES_PASSWORD=voodoo -p 5432:5432 -d postgres:16
# VOODOO_TEST_DATABASE_URL=postgresql://voodoo:voodoo@localhost:5432/voodoo_test

# S3-compatible object store contract tests (tests/contracts/test_objectstore_s3.py)
# Set VOODOO_TEST_S3_ENDPOINT to an S3-compatible server (AWS S3, MinIO, R2)
# to run the object store contract suite; leave commented to skip it.
# Enable:  VOODOO_TEST_S3_ENDPOINT=http://localhost:9000
# Disable: comment the line out — tests skip with a clear reason.
# Example local container (MinIO):
#   docker run --name voodoo-minio -p 9000:9000 \
#     -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#     -d minio/minio server /data --console-address ":9001"
# VOODOO_TEST_S3_ENDPOINT=http://localhost:9000
# VOODOO_TEST_S3_BUCKET=voodoo-test
# VOODOO_TEST_S3_KEY=minioadmin
# VOODOO_TEST_S3_SECRET=minioadmin

# Redis queue + cache contract tests (tests/contracts/test_queue_redis.py,
# tests/contracts/test_cache_redis.py)
# Set VOODOO_TEST_REDIS_URL to a Redis server to run the Redis adapter
# contract suites; leave commented to skip them (default local runs stay
# zero-infra).
# Enable:  VOODOO_TEST_REDIS_URL=redis://localhost:6379/0
# Disable: comment the line out — tests skip with a clear reason.
# Example local container:
#   docker run --name voodoo-redis -p 6379:6379 -d redis:7
# VOODOO_TEST_REDIS_URL=redis://localhost:6379/0

# Storage
# Defines the folder where uploads and static files will be saved.
# Default: `storage`
# VOODOO_STORAGE_DIR=/var/lib/data/storage

# Web Server
# HOST=0.0.0.0
# PORT=8080
