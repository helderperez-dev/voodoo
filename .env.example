# Voodoo Framework Environment Variables

# Database
# In development, leave commented to use `.data/voodoo.db`
# In production, set the absolute path where the persistent volume is mounted.
# VOODOO_DB_PATH=/var/lib/data/voodoo.db

# PostgreSQL contract tests (tests/contracts/test_database_postgres.py)
# Set this to a PostgreSQL connection URL to run the PG adapter contract
# suite; leave commented to skip it (default local runs stay zero-infra).
# Enable:  VOODOO_TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/db
# Disable: comment the line out — tests skip with a clear reason.
# Example local container:
#   docker run --name voodoo-pg -e POSTGRES_DB=voodoo_test \
#     -e POSTGRES_USER=voodoo -e POSTGRES_PASSWORD=voodoo -p 5432:5432 -d postgres:16
# VOODOO_TEST_DATABASE_URL=postgresql://voodoo:voodoo@localhost:5432/voodoo_test

# Storage
# Defines the folder where uploads and static files will be saved.
# Default: `storage`
# VOODOO_STORAGE_DIR=/var/lib/data/storage

# Web Server
# HOST=0.0.0.0
# PORT=8080
