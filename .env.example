# ═══════════════════════════════════════════════════════════════════════════
# Voodoo Framework — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and adjust as needed.
# All variables are optional — Voodoo runs zero-config out of the box.
#
# Precedence: voodoo.yaml > environment variables > local defaults
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# Runtime
# ───────────────────────────────────────────────────────────────────────────

# Environment: "development" (default) or "production".
# In production: disables debug mode, enables production middleware.
# VOODOO_ENV=production

# Debug mode. Explicitly set to "true" or "false" to override the default
# (on in development, off in production).
# VOODOO_DEBUG=false

# Runtime mode (used by the execution engine). Defaults to VOODOO_ENV.
# VOODOO_RUNTIME_MODE=production

# Web server bind address and port.
# VOODOO_HOST=0.0.0.0
# VOODOO_PORT=8000


# ───────────────────────────────────────────────────────────────────────────
# Authentication & Security
# ───────────────────────────────────────────────────────────────────────────

# Secret key for JWT signing. MUST be set in production.
# Generate one with: voodoo auth secret-key
# VOODOO_SECRET_KEY=change-me-in-production

# JWT token expiry in seconds (default: 7 days = 604800).
# VOODOO_TOKEN_EXPIRY=604800


# ───────────────────────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────────────────────

# SQLite database file path (default: .voodoo/state/data.db).
# VOODOO_DB_PATH=.voodoo/state/data.db

# Database provider: "sqlite" (default) or "postgres".
# VOODOO_DATABASE_PROVIDER=sqlite

# Database URL for server-based databases (PostgreSQL).
# When set, takes precedence over VOODOO_DB_PATH.
# VOODOO_DATABASE_URL=postgresql://user:pass@localhost:5432/voodoo


# ───────────────────────────────────────────────────────────────────────────
# Task Queue
# ───────────────────────────────────────────────────────────────────────────

# Queue provider: "sqlite" (default), "postgres", or "redis".
# VOODOO_QUEUE_PROVIDER=sqlite

# Queue URL (for redis or postgres providers).
# VOODOO_QUEUE_URL=redis://localhost:6379/0

# Redis URL (fallback for queue, events, and cache when their URLs are unset).
# VOODOO_REDIS_URL=redis://localhost:6379/0


# ───────────────────────────────────────────────────────────────────────────
# Events
# ───────────────────────────────────────────────────────────────────────────

# Event bus provider: "sqlite" (default), "postgres", or "memory".
# VOODOO_EVENTS_PROVIDER=sqlite

# Event store URL (for postgres provider).
# VOODOO_EVENTS_URL=postgresql://user:pass@localhost:5432/voodoo

# Event store file path (defaults to the database path).
# VOODOO_EVENTS_PATH=.voodoo/state/data.db


# ───────────────────────────────────────────────────────────────────────────
# Object Store
# ───────────────────────────────────────────────────────────────────────────

# Object store provider: "local" (default) or "s3".
# VOODOO_OBJECTS_PROVIDER=local

# Local object store directory (default: .voodoo/objects).
# VOODOO_OBJECTS_DIR=.voodoo/objects

# S3-compatible configuration (when provider is "s3").
# VOODOO_S3_KEY=minioadmin
# VOODOO_S3_SECRET=minioadmin
# VOODOO_S3_ENDPOINT=http://localhost:9000
# VOODOO_BUCKET=voodoo-objects

# AWS fallbacks (used if VOODOO_S3_* vars are unset).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
# AWS_REGION=us-east-1


# ───────────────────────────────────────────────────────────────────────────
# Cache
# ───────────────────────────────────────────────────────────────────────────

# Cache provider: "memory" (default) or "redis".
# VOODOO_CACHE_PROVIDER=memory

# Cache URL (for redis provider).
# VOODOO_CACHE_URL=redis://localhost:6379/0


# ───────────────────────────────────────────────────────────────────────────
# AI Models
# ───────────────────────────────────────────────────────────────────────────

# Default model alias or provider:model string.
# VOODOO_MODELS_DEFAULT=openai:gpt-4o

# Provider API keys (set the ones you use).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...


# ───────────────────────────────────────────────────────────────────────────
# Storage (uploads & static files)
# ───────────────────────────────────────────────────────────────────────────

# Directory for user uploads and generated static files (default: storage).
# VOODOO_STORAGE_DIR=storage


# ═══════════════════════════════════════════════════════════════════════════
# TEST INFRASTRUCTURE (optional — only for running contract test suites)
# ═══════════════════════════════════════════════════════════════════════════
#
# These variables enable contract tests against external services.
# Leave them commented to skip the tests (default local runs stay zero-infra).
# See CONTRIBUTING.md for Docker setup instructions.

# PostgreSQL contract tests (tests/contracts/test_database_postgres.py)
# docker run --name voodoo-pg -e POSTGRES_DB=voodoo_test \
#   -e POSTGRES_USER=voodoo -e POSTGRES_PASSWORD=voodoo -p 5432:5432 -d postgres:16
# VOODOO_TEST_DATABASE_URL=postgresql://voodoo:voodoo@localhost:5432/voodoo_test

# S3-compatible object store contract tests (tests/contracts/test_objectstore_s3.py)
# docker run --name voodoo-minio -p 9000:9000 \
#   -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#   -d minio/minio server /data --console-address ":9001"
# VOODOO_TEST_S3_ENDPOINT=http://localhost:9000
# VOODOO_TEST_S3_BUCKET=voodoo-test
# VOODOO_TEST_S3_KEY=minioadmin
# VOODOO_TEST_S3_SECRET=minioadmin

# Redis queue + cache contract tests (tests/contracts/test_queue_redis.py,
# tests/contracts/test_cache_redis.py)
# docker run --name voodoo-redis -p 6379:6379 -d redis:7
# VOODOO_TEST_REDIS_URL=redis://localhost:6379/0
